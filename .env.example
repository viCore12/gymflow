# ──────────────────────────────────────────────────────────────────────────────
# GymFlow — environment variables template
# Copy to .env and fill in secrets before running.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=gymflow
POSTGRES_DB=gymflow
POSTGRES_PASSWORD=gymflow_dev
DATABASE_URL=postgresql+asyncpg://gymflow:gymflow_dev@localhost:5432/gymflow

# Port override if 5432 is taken locally
DB_PORT=5432

# ── JWT (API) ─────────────────────────────────────────────────────────────────
JWT_SECRET=dev_jwt_secret_change_in_prod
JWT_EXPIRES_IN=7d

# ── NextAuth (admin) ──────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev_nextauth_secret_change_in_prod

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=gymflow

# Console UI (local dev only)
MINIO_CONSOLE_PORT=9001

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
# Accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-to-server (inside Docker: http://api:8000)
API_URL=http://localhost:8000

# ── App ports ─────────────────────────────────────────────────────────────────
ADMIN_PORT=3000
WEB_PORT=3002

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development
